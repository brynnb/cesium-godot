       const TilesetOptions& tilesetOptions);
diff --git a/Cesium3DTilesSelection/test/SimplePrepareRendererResource.h b/Cesium3DTilesSelection/test/SimplePrepareRendererResource.h
index 202e1a6..b401614 100644
--- a/Cesium3DTilesSelection/test/SimplePrepareRendererResource.h
+++ b/Cesium3DTilesSelection/test/SimplePrepareRendererResource.h
@@ -14,6 +14,8 @@ class SimplePrepareRendererResource
     : public Cesium3DTilesSelection::IPrepareRendererResources {
 public:
   std::atomic<size_t> totalAllocation{};
+  size_t incrementalStepsRemaining = 0;
+  size_t mainThreadPreparationCount = 0;
 
   struct AllocationResult {
     AllocationResult(std::atomic<size_t>& allocCount_)
@@ -43,6 +45,7 @@ public:
   virtual void* prepareInMainThread(
       Cesium3DTilesSelection::Tile& /*tile*/,
       void* pLoadThreadResult) override {
+    ++this->mainThreadPreparationCount;
     if (pLoadThreadResult) {
       AllocationResult* loadThreadResult =
           reinterpret_cast<AllocationResult*>(pLoadThreadResult);
@@ -52,6 +55,19 @@ public:
     return new AllocationResult{totalAllocation};
   }
 
+  virtual MainThreadRendererResourcesPreparationResult
+  prepareInMainThreadIncrementally(
+      Cesium3DTilesSelection::Tile& tile,
+      void* pLoadThreadResult,
+      double /*timeBudgetMilliseconds*/) override {
+    if (this->incrementalStepsRemaining > 1) {
+      --this->incrementalStepsRemaining;
+      return {nullptr, false};
+    }
+    this->incrementalStepsRemaining = 0;
+    return {this->prepareInMainThread(tile, pLoadThreadResult), true};
+  }
+
   virtual void free(
       Cesium3DTilesSelection::Tile& /*tile*/,
       void* pLoadThreadResult,
diff --git a/Cesium3DTilesSelection/test/TestTileLoadRequester.cpp b/Cesium3DTilesSelection/test/TestTileLoadRequester.cpp
index 1587326..9ab6915 100644
--- a/Cesium3DTilesSelection/test/TestTileLoadRequester.cpp
+++ b/Cesium3DTilesSelection/test/TestTileLoadRequester.cpp
@@ -4,6 +4,8 @@
 #include <CesiumNativeTests/SimpleAssetAccessor.h>
 #include <CesiumNativeTests/SimpleTaskProcessor.h>
 
+#include "SimplePrepareRendererResource.h"
+
 #include <doctest/doctest.h>
 
 using namespace Cesium3DTilesSelection;
@@ -149,6 +151,77 @@ TEST_CASE("TileLoadRequester") {
       pTileset->loadTiles();
       CHECK(pToLoad->getState() == TileLoadState::Done);
     }
+
+    SUBCASE("resumes incremental main-thread renderer preparation") {
+      auto pIncrementalRenderer =
+          std::make_shared<SimplePrepareRendererResource>();
+      pIncrementalRenderer->incrementalStepsRemaining = 2;
+      TilesetExternals incrementalExternals = externals;
+      incrementalExternals.pPrepareRendererResources = pIncrementalRenderer;
+      TilesetOptions options;
+      options.mainThreadLoadingTimeLimit = 5.0;
+      auto pIncrementalTileset =
+          EllipsoidTilesetLoader::createTileset(incrementalExternals, options);
+      TestTileLoadRequester requester;
+      pIncrementalTileset->registerLoadRequester(requester);
+
+      const Tile* pToLoad =
+          &pIncrementalTileset->getRootTile()->getChildren()[1];
+      requester.setWorkerThreadQueue({pToLoad});
+      pIncrementalTileset->loadTiles();
+      while (pToLoad->getState() == TileLoadState::ContentLoading) {
+        incrementalExternals.asyncSystem.dispatchMainThreadTasks();
+      }
+      REQUIRE(pToLoad->getState() == TileLoadState::ContentLoaded);
+      void* pWorkerResult =
+          pToLoad->getContent().getRenderContent()->getRenderResources();
+      REQUIRE(pWorkerResult != nullptr);
+
+      requester.setMainThreadQueue({pToLoad});
+      pIncrementalTileset->loadTiles();
+      CHECK(pToLoad->getState() == TileLoadState::ContentLoaded);
+      CHECK(
+          pToLoad->getContent().getRenderContent()->getRenderResources() ==
+          pWorkerResult);
+      CHECK(pIncrementalRenderer->mainThreadPreparationCount == 0);
+
+      requester.setMainThreadQueue({pToLoad});
+      pIncrementalTileset->loadTiles();
+      CHECK(pToLoad->getState() == TileLoadState::Done);
+      CHECK(pIncrementalRenderer->mainThreadPreparationCount == 1);
+    }
+
+    SUBCASE("releases incomplete incremental renderer preparation") {
+      auto pIncrementalRenderer =
+          std::make_shared<SimplePrepareRendererResource>();
+      pIncrementalRenderer->incrementalStepsRemaining = 3;
+      TilesetExternals incrementalExternals = externals;
+      incrementalExternals.pPrepareRendererResources = pIncrementalRenderer;
+      TilesetOptions options;
+      options.mainThreadLoadingTimeLimit = 5.0;
+      auto pIncrementalTileset =
+          EllipsoidTilesetLoader::createTileset(incrementalExternals, options);
+      TestTileLoadRequester requester;
+      pIncrementalTileset->registerLoadRequester(requester);
+
+      const Tile* pToLoad =
+          &pIncrementalTileset->getRootTile()->getChildren()[1];
+      requester.setWorkerThreadQueue({pToLoad});
+      pIncrementalTileset->loadTiles();
+      while (pToLoad->getState() == TileLoadState::ContentLoading) {
+        incrementalExternals.asyncSystem.dispatchMainThreadTasks();
+      }
+      REQUIRE(pToLoad->getState() == TileLoadState::ContentLoaded);
+      REQUIRE(pIncrementalRenderer->totalAllocation == 1);
+
+      requester.setMainThreadQueue({pToLoad});
+      pIncrementalTileset->loadTiles();
+      REQUIRE(pToLoad->getState() == TileLoadState::ContentLoaded);
+      REQUIRE(pIncrementalRenderer->mainThreadPreparationCount == 0);
+
+      pIncrementalTileset.reset();
+      CHECK(pIncrementalRenderer->totalAllocation == 0);
+    }
   }
 
   SUBCASE("with a simple flat tileset") {
