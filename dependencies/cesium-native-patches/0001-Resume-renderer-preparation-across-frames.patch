 .../src/TilesetContentManager.cpp             | 81 +++++++++++++------
 .../src/TilesetContentManager.h               |  5 ++
 .../test/SimplePrepareRendererResource.h      | 16 ++++
 .../test/TestTileLoadRequester.cpp            | 73 +++++++++++++++++
 5 files changed, 195 insertions(+), 24 deletions(-)

diff --git a/Cesium3DTilesSelection/include/Cesium3DTilesSelection/IPrepareRendererResources.h b/Cesium3DTilesSelection/include/Cesium3DTilesSelection/IPrepareRendererResources.h
index dbda49f..5548421 100644
--- a/Cesium3DTilesSelection/include/Cesium3DTilesSelection/IPrepareRendererResources.h
+++ b/Cesium3DTilesSelection/include/Cesium3DTilesSelection/IPrepareRendererResources.h
@@ -53,6 +53,23 @@ struct TileLoadResultAndRenderResources {
   void* pRenderResources{nullptr};
 };
 
+/**
+ * @brief The result of one bounded main-thread renderer preparation step.
+ */
+struct MainThreadRendererResourcesPreparationResult {
+  /**
+   * @brief The completed renderer resources, or `nullptr` while preparation is
+   * incomplete.
+   */
+  void* pRenderResources{nullptr};
+
+  /**
+   * @brief Whether ownership of the load-thread result has been consumed and
+   * renderer preparation is complete.
+   */
+  bool isComplete{true};
+};
+
 /**
  * @brief When implemented for a rendering engine, allows renderer resources to
  * be created and destroyed under the control of a {@link Tileset}.
@@ -109,6 +126,33 @@ public:
    */
   virtual void* prepareInMainThread(Tile& tile, void* pLoadThreadResult) = 0;
 
+  /**
+   * @brief Performs a bounded portion of main-thread renderer preparation.
+   *
+   * The default preserves the original one-shot contract by calling
+   * {@link prepareInMainThread}. Implementations may instead retain incremental
+   * state inside `pLoadThreadResult`, return `isComplete == false`, and resume
+   * when called again on a later frame. While incomplete, the returned renderer
+   * resource pointer must be `nullptr` and ownership of `pLoadThreadResult`
+   * remains with the implementation. An incremental implementation must make
+   * finite forward progress on every call and eventually complete, including
+   * when the time budget is zero (the unthrottled compatibility path).
+   *
+   * @param tile The tile being prepared.
+   * @param pLoadThreadResult The still-owned load-thread preparation result.
+   * @param timeBudgetMilliseconds The aggregate time remaining in this frame,
+   * or zero when preparation is unthrottled.
+   */
+  virtual MainThreadRendererResourcesPreparationResult
+  prepareInMainThreadIncrementally(
+      Tile& tile,
+      void* pLoadThreadResult,
+      double /*timeBudgetMilliseconds*/) {
+    return MainThreadRendererResourcesPreparationResult{
+        this->prepareInMainThread(tile, pLoadThreadResult),
+        true};
+  }
+
   /**
    * @brief Frees previously-prepared renderer resources.
    *
diff --git a/Cesium3DTilesSelection/src/TilesetContentManager.cpp b/Cesium3DTilesSelection/src/TilesetContentManager.cpp
index 52ed00b..69d6324 100644
--- a/Cesium3DTilesSelection/src/TilesetContentManager.cpp
+++ b/Cesium3DTilesSelection/src/TilesetContentManager.cpp
@@ -1484,9 +1484,9 @@ void TilesetContentManager::unloadAll() {
 
 bool TilesetContentManager::waitUntilIdle(
     double maximumWaitTimeInMilliseconds) {
-  auto start = std::chrono::system_clock::now();
+  auto start = std::chrono::steady_clock::now();
   auto end = (maximumWaitTimeInMilliseconds <= 0.0)
-                 ? std::chrono::time_point<std::chrono::system_clock>::max()
+                 ? std::chrono::time_point<std::chrono::steady_clock>::max()
                  : (start + std::chrono::microseconds(static_cast<int64_t>(
                                 1000.0 * maximumWaitTimeInMilliseconds)));
 
@@ -1497,7 +1497,7 @@ bool TilesetContentManager::waitUntilIdle(
     this->_externals.pAssetAccessor->tick();
     this->_externals.asyncSystem.dispatchMainThreadTasks();
 
-    auto time = std::chrono::system_clock::now();
+    auto time = std::chrono::steady_clock::now();
     if (time >= end) {
       break;
     }
@@ -1515,7 +1515,7 @@ bool TilesetContentManager::waitUntilIdle(
       rasterOverlayTilesLoading += pActivated->getNumberOfTilesLoading();
     }
 
-    auto time = std::chrono::system_clock::now();
+    auto time = std::chrono::steady_clock::now();
     if (time >= end) {
       break;
     }
@@ -1591,13 +1591,21 @@ int64_t TilesetContentManager::getTotalDataUsed() const noexcept {
 void TilesetContentManager::finishLoading(
     Tile& tile,
     const TilesetOptions& tilesetOptions) {
+  while (!this->finishLoadingIncrementally(tile, tilesetOptions, 0.0)) {
+  }
+}
+
+bool TilesetContentManager::finishLoadingIncrementally(
+    Tile& tile,
+    const TilesetOptions& tilesetOptions,
+    double timeBudgetMilliseconds) {
   TileContent& content = tile.getContent();
 
   // If this tile doesn't have render content, there's nothing to finish
   // loading.
   TileRenderContent* pRenderContent = content.getRenderContent();
   if (pRenderContent == nullptr)
-    return;
+    return true;
 
   if (this->_externals.pGltfModifier &&
       this->_externals.pGltfModifier->needsMainThreadModification(tile)) {
@@ -1624,15 +1632,31 @@ void TilesetContentManager::finishLoading(
     }
 
     pRenderContent->setGltfModifierState(GltfModifierState::Idle);
-    return;
+    return true;
   }
 
   // None of the processing below makes sense until the Tile hits the
   // ContentLoaded state.
   if (tile.getState() != TileLoadState::ContentLoaded)
-    return;
+    return true;
 
-  // add copyright
+  void* pWorkerRenderResources = pRenderContent->getRenderResources();
+  if (this->_externals.pPrepareRendererResources) {
+    MainThreadRendererResourcesPreparationResult preparation =
+        this->_externals.pPrepareRendererResources
+            ->prepareInMainThreadIncrementally(
+                tile,
+                pWorkerRenderResources,
+                timeBudgetMilliseconds);
+    if (!preparation.isComplete) {
+      CESIUM_ASSERT(preparation.pRenderResources == nullptr);
+      return false;
+    }
+    pRenderContent->setRenderResources(preparation.pRenderResources);
+  }
+
+  // Add copyright only after incremental renderer preparation completes so
+  // repeated steps cannot duplicate credits.
   CreditSystem* pCreditSystem = this->_externals.pCreditSystem.get();
   if (pCreditSystem) {
     std::vector<std::string_view> creditStrings =
@@ -1651,21 +1675,12 @@ void TilesetContentManager::finishLoading(
     pRenderContent->setCredits(credits);
   }
 
-  // Run the main thread part of loading.
-  void* pWorkerRenderResources = pRenderContent->getRenderResources();
-  if (this->_externals.pPrepareRendererResources) {
-    void* pMainThreadRenderResources =
-        this->_externals.pPrepareRendererResources->prepareInMainThread(
-            tile,
-            pWorkerRenderResources);
-    pRenderContent->setRenderResources(pMainThreadRenderResources);
-  }
-
   tile.setState(TileLoadState::Done);
 
   // This allows the raster tile to be updated and children to be created, if
   // necessary.
   updateTileContent(tile, tilesetOptions);
+  return true;
 }
 
 void TilesetContentManager::markTileIneligibleForContentUnloading(Tile& tile) {
@@ -1690,9 +1705,9 @@ void TilesetContentManager::unloadCachedBytes(
 
   // A time budget of 0.0 indicates we shouldn't throttle cache unloads. So set
   // the end time to the max time_point in that case.
-  auto start = std::chrono::system_clock::now();
+  auto start = std::chrono::steady_clock::now();
   auto end = (timeBudgetMilliseconds <= 0.0)
-                 ? std::chrono::time_point<std::chrono::system_clock>::max()
+                 ? std::chrono::time_point<std::chrono::steady_clock>::max()
                  : (start + std::chrono::microseconds(static_cast<int64_t>(
                                 1000.0 * timeBudgetMilliseconds)));
 
@@ -1717,7 +1732,7 @@ void TilesetContentManager::unloadCachedBytes(
 
     pTile = pNext;
 
-    auto time = std::chrono::system_clock::now();
+    auto time = std::chrono::steady_clock::now();
     if (time >= end) {
       break;
     }
@@ -1937,7 +1952,7 @@ void TilesetContentManager::processMainThreadLoadRequests(
 
   double timeBudget = options.mainThreadLoadingTimeLimit;
 
-  auto start = std::chrono::system_clock::now();
+  auto start = std::chrono::steady_clock::now();
   auto end = start + std::chrono::microseconds(
                          static_cast<int64_t>(1000.0 * timeBudget));
 
@@ -1952,9 +1967,27 @@ void TilesetContentManager::processMainThreadLoadRequests(
     if (pToLoad->_referenceCount == 0)
       continue;
 
-    this->finishLoading(*pToLoad, options);
+    double remainingMilliseconds = 0.0;
+    if (timeBudget > 0.0) {
+      remainingMilliseconds = std::max(
+          0.0,
+          std::chrono::duration<double, std::milli>(
+              end - std::chrono::steady_clock::now())
+              .count());
+      if (remainingMilliseconds <= 0.0) {
+        break;
+      }
+    }
+    if (!this->finishLoadingIncrementally(
+            *pToLoad,
+            options,
+            remainingMilliseconds)) {
+      // An incomplete renderer consumed this frame's useful preparation
+      // window. The still-ContentLoaded tile will be queued again next frame.
+      break;
+    }
 
-    auto time = std::chrono::system_clock::now();
+    auto time = std::chrono::steady_clock::now();
     if (timeBudget > 0.0 && time >= end) {
       break;
     }
diff --git a/Cesium3DTilesSelection/src/TilesetContentManager.h b/Cesium3DTilesSelection/src/TilesetContentManager.h
