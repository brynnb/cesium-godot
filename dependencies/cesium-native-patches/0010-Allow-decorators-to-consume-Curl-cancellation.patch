From: brynnb <brynnb@users.noreply.github.com>
Date: Wed, 12 Aug 2026 08:29:56 -0700
Subject: [PATCH 10/11] Allow decorators to consume Curl cancellation

---
 .../include/CesiumCurl/CurlAssetAccessor.h    | 11 ++++
 CesiumCurl/src/CurlAssetAccessor.cpp          | 27 +++++++-
 CesiumCurl/test/TestCurlAssetAccessor.cpp     | 65 +++++++++++++++++++
 3 files changed, 100 insertions(+), 3 deletions(-)

diff --git a/CesiumCurl/include/CesiumCurl/CurlAssetAccessor.h b/CesiumCurl/include/CesiumCurl/CurlAssetAccessor.h
index a8e2e74..97a568e 100644
--- a/CesiumCurl/include/CesiumCurl/CurlAssetAccessor.h
+++ b/CesiumCurl/include/CesiumCurl/CurlAssetAccessor.h
@@ -80,6 +80,17 @@ struct CESIUMCURL_API CurlAssetAccessorOptions {
    * false if the initialization and cleanup are done elsewhere.
    */
   bool doGlobalInit{true};
+
+  /**
+   * @brief Whether a canceled transfer resolves with an asset request whose
+   * response is null instead of rejecting the returned future.
+   *
+   * The default preserves the historical standalone accessor behavior. This
+   * option is useful for decorators that consume cancellation themselves and
+   * must not propagate a rejection while another async continuation is being
+   * unwound.
+   */
+  bool resolveCancellationAsNullResponse{false};
 };
 
 /**
