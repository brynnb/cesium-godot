+    SUBCASE("can resolve an aborted active transfer") {
+      using namespace std::chrono_literals;
+
+      constexpr size_t responseSize = 64 * 1024 * 1024;
+      std::atomic_bool responseStarted{false};
+      pServer->Get(
+          "/test/slow-resolved.bin",
+          [&responseStarted](const httplib::Request& /*request*/,
+                             httplib::Response& response) {
+            response.set_content_provider(
+                responseSize,
+                "application/octet-stream",
+                [&responseStarted](size_t /*offset*/,
+                                   size_t length,
+                                   httplib::DataSink& sink) {
+                  responseStarted.store(true, std::memory_order_release);
+                  std::this_thread::sleep_for(2ms);
+                  const std::string bytes(length, 'x');
+                  return sink.write(bytes.data(), bytes.size());
+                });
+          });
+
+      options.resolveCancellationAsNullResponse = true;
+      pAssetAccessor = std::make_shared<CurlAssetAccessor>(options);
+      auto pCanceled = std::make_shared<std::atomic_bool>(false);
+      CesiumAsync::AssetRequestOptions requestOptions{pCanceled};
+      auto future = pAssetAccessor->getWithOptions(
+          asyncSystem,
+          fmt::format(
+              "http://127.0.0.1:{}/test/slow-resolved.bin",
+              port),
+          {},
+          requestOptions);
+
+      std::thread cancelThread([&responseStarted, pCanceled]() {
+        while (!responseStarted.load(std::memory_order_acquire)) {
+          std::this_thread::yield();
+        }
+        pCanceled->store(true, std::memory_order_relaxed);
+      });
+
+      std::shared_ptr<CesiumAsync::IAssetRequest> pRequest =
+          future.waitInMainThread();
+      cancelThread.join();
+      REQUIRE(pRequest);
+      CHECK(pRequest->response() == nullptr);
+    }
