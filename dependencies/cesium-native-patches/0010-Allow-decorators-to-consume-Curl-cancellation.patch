+  SUBCASE("can resolve a request canceled before transfer") {
+    options.resolveCancellationAsNullResponse = true;
+    pAssetAccessor = std::make_shared<CurlAssetAccessor>(options);
+    auto pCanceled = std::make_shared<std::atomic_bool>(true);
+    CesiumAsync::AssetRequestOptions requestOptions{pCanceled};
+    std::shared_ptr<CesiumAsync::IAssetRequest> pRequest =
+        pAssetAccessor
+            ->getWithOptions(
+                asyncSystem,
+                "http://127.0.0.1:1/will-not-connect",
+                {},
+                requestOptions)
+            .waitInMainThread();
+    REQUIRE(pRequest);
+    CHECK(pRequest->response() == nullptr);
+  }
