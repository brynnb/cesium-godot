From: brynnb <brynnb@users.noreply.github.com>
Date: Wed, 12 Aug 2026 20:03:19 -0700
Subject: [PATCH 1/2] Keep cache accounting stable across glTF modifier updates

---
 .../src/TilesetContentManager.cpp             | 73 ++++++++-------
 .../src/TilesetContentManager.h               |  6 ++
 .../test/TestTilesetContentManager.cpp        | 90 +++++++++++++++++++
 3 files changed, 139 insertions(+), 30 deletions(-)

diff --git a/Cesium3DTilesSelection/src/TilesetContentManager.cpp b/Cesium3DTilesSelection/src/TilesetContentManager.cpp
index 8290a39..9ce8dea 100644
--- a/Cesium3DTilesSelection/src/TilesetContentManager.cpp
+++ b/Cesium3DTilesSelection/src/TilesetContentManager.cpp
@@ -1187,7 +1187,7 @@ void TilesetContentManager::reapplyGltfModifier(
             pTile->getContent().getRenderContent();
         CESIUM_ASSERT(pRenderContent != nullptr);
 
-        this->notifyTileDoneLoading(pTile.get());
+        this->notifyTileLoadFinished();
 
         if (std::holds_alternative<TileUnknownContent>(
                 pair.result.contentKind)) {
@@ -1213,8 +1213,10 @@ void TilesetContentManager::reapplyGltfModifier(
                 pRenderContent->getRenderResources(),
                 nullptr);
           }
+          this->removeTileDataUsage(*pTile);
           pRenderContent->setModel(
               std::move(std::get<CesiumGltf::Model>(pair.result.contentKind)));
+          this->addTileDataUsage(*pTile);
           pRenderContent->setRenderResources(pair.pRenderResources);
           pRenderContent->setGltfModifierState(GltfModifierState::Idle);
 
@@ -1246,7 +1248,7 @@ void TilesetContentManager::reapplyGltfModifier(
               std::exception&& e) {
             pTile->getContent().getRenderContent()->setGltfModifierState(
                 GltfModifierState::WorkerDone);
-            this->notifyTileDoneLoading(pTile.get());
+            this->notifyTileLoadFinished();
             SPDLOG_LOGGER_ERROR(
                 externals.pLogger,
                 "An unexpected error occurred when reapplying GltfModifier: {}",
@@ -1802,7 +1804,9 @@ bool TilesetContentManager::finishLoadingIncrementally(
 
     // Replace model and render resources with the newly modified versions,
     // discarding the old ones
+    this->removeTileDataUsage(tile);
     pRenderContent->replaceWithModifiedModel();
+    this->addTileDataUsage(tile);
 
     // Run the main thread part of loading.
     if (this->_externals.pPrepareRendererResources) {
@@ -2445,55 +2449,64 @@ void TilesetContentManager::notifyTileStartLoading(
   ++this->_tileLoadsInProgress;
 }
 
-void TilesetContentManager::notifyTileDoneLoading(const Tile* pTile) noexcept {
+void TilesetContentManager::notifyTileLoadFinished() noexcept {
   CESIUM_ASSERT(
       this->_tileLoadsInProgress > 0 &&
       "There are no tile loads currently in flight");
   --this->_tileLoadsInProgress;
+}
+
+void TilesetContentManager::notifyTileDoneLoading(const Tile* pTile) noexcept {
+  this->notifyTileLoadFinished();
   ++this->_loadedTilesCount;
 
   if (pTile) {
-    this->_tilesDataUsed += computeTileNonImageDataBytes(*pTile);
-    for (const CesiumImage::ImageAsset* pImage : getUniqueTileImages(*pTile)) {
-      auto [it, inserted] = this->_loadedSharedImageUsage.try_emplace(
-          pImage,
-          LoadedSharedImageUsage{0, pImage->getSizeBytes()});
-      ++it->second.referenceCount;
-      if (inserted) {
-        this->_tilesDataUsed += it->second.sizeBytes;
-      }
-    }
+    this->addTileDataUsage(*pTile);
   }
 }
 
 void TilesetContentManager::notifyTileLoadCanceled(
     [[maybe_unused]] const Tile* pTile) noexcept {
-  CESIUM_ASSERT(
-      this->_tileLoadsInProgress > 0 &&
-      "There are no tile loads currently in flight");
-  --this->_tileLoadsInProgress;
+  this->notifyTileLoadFinished();
 }
 
 void TilesetContentManager::notifyTileUnloading(const Tile* pTile) noexcept {
   if (pTile) {
-    this->_tilesDataUsed -= computeTileNonImageDataBytes(*pTile);
-    for (const CesiumImage::ImageAsset* pImage : getUniqueTileImages(*pTile)) {
-      auto it = this->_loadedSharedImageUsage.find(pImage);
-      CESIUM_ASSERT(it != this->_loadedSharedImageUsage.end());
-      if (it == this->_loadedSharedImageUsage.end()) {
-        continue;
-      }
-      CESIUM_ASSERT(it->second.referenceCount > 0);
-      if (--it->second.referenceCount == 0) {
-        this->_tilesDataUsed -= it->second.sizeBytes;
-        this->_loadedSharedImageUsage.erase(it);
-      }
-    }
+    this->removeTileDataUsage(*pTile);
   }
 
   --this->_loadedTilesCount;
 }
 
+void TilesetContentManager::addTileDataUsage(const Tile& tile) noexcept {
+  this->_tilesDataUsed += computeTileNonImageDataBytes(tile);
+  for (const CesiumImage::ImageAsset* pImage : getUniqueTileImages(tile)) {
+    auto [it, inserted] = this->_loadedSharedImageUsage.try_emplace(
+        pImage,
+        LoadedSharedImageUsage{0, pImage->getSizeBytes()});
+    ++it->second.referenceCount;
+    if (inserted) {
+      this->_tilesDataUsed += it->second.sizeBytes;
+    }
+  }
+}
+
+void TilesetContentManager::removeTileDataUsage(const Tile& tile) noexcept {
+  this->_tilesDataUsed -= computeTileNonImageDataBytes(tile);
+  for (const CesiumImage::ImageAsset* pImage : getUniqueTileImages(tile)) {
+    auto it = this->_loadedSharedImageUsage.find(pImage);
+    CESIUM_ASSERT(it != this->_loadedSharedImageUsage.end());
+    if (it == this->_loadedSharedImageUsage.end()) {
+      continue;
+    }
+    CESIUM_ASSERT(it->second.referenceCount > 0);
+    if (--it->second.referenceCount == 0) {
+      this->_tilesDataUsed -= it->second.sizeBytes;
+      this->_loadedSharedImageUsage.erase(it);
+    }
+  }
+}
+
 template <class TilesetContentLoaderType>
 void TilesetContentManager::propagateTilesetContentLoaderResult(
     TilesetLoadType type,
