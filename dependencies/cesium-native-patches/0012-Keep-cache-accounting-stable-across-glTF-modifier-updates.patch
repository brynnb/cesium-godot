--- a/Cesium3DTilesSelection/src/TilesetContentManager.h
+++ b/Cesium3DTilesSelection/src/TilesetContentManager.h
@@ -224,12 +224,18 @@ private:
 
   void notifyTileStartLoading(const Tile* pTile) noexcept;
 
+  void notifyTileLoadFinished() noexcept;
+
   void notifyTileDoneLoading(const Tile* pTile) noexcept;
 
   void notifyTileLoadCanceled(const Tile* pTile) noexcept;
 
   void notifyTileUnloading(const Tile* pTile) noexcept;
 
+  void addTileDataUsage(const Tile& tile) noexcept;
+
+  void removeTileDataUsage(const Tile& tile) noexcept;
+
   void reapplyGltfModifier(
       Tile& tile,
       const TilesetOptions& tilesetOptions,
diff --git a/Cesium3DTilesSelection/test/TestTilesetContentManager.cpp b/Cesium3DTilesSelection/test/TestTilesetContentManager.cpp
index de21583..fe8141c 100644
--- a/Cesium3DTilesSelection/test/TestTilesetContentManager.cpp
+++ b/Cesium3DTilesSelection/test/TestTilesetContentManager.cpp
@@ -2081,3 +2081,93 @@ TEST_CASE("Test glTF modifier state machine") {
     CHECK(pMockedPrepareRendererResources->totalAllocation == 0);
   }
 }
+
+TEST_CASE("glTF modifier reapplies replace accounted image assets") {
+  Cesium3DTilesContent::registerAllTileContentTypes();
+
+  auto pAssetAccessor = std::make_shared<SimpleAssetAccessor>(
+      std::map<std::string, std::shared_ptr<SimpleAssetRequest>>{});
+  auto pPrepareRendererResources =
+      std::make_shared<SimplePrepareRendererResource>();
+  CesiumAsync::AsyncSystem asyncSystem{std::make_shared<SimpleTaskProcessor>()};
+  auto pCreditSystem = std::make_shared<CreditSystem>();
+
+  class ImageSwappingGltfModifier final : public GltfModifier {
+  public:
+    int32_t applyCallCount = 0;
+
+    CesiumAsync::Future<std::optional<GltfModifierOutput>>
+    apply(GltfModifierInput&& input) override {
+      ++this->applyCallCount;
+      GltfModifierOutput output{.modifiedModel = input.previousModel};
+      REQUIRE(output.modifiedModel.images.size() == 1);
+      output.modifiedModel.images[0].pAsset.emplace();
+      output.modifiedModel.images[0].pAsset->sizeBytes =
+          100 * (this->applyCallCount + 1);
+      return input.asyncSystem.createResolvedFuture(
+          std::make_optional(std::move(output)));
+    }
+  };
+
+  auto pModifier = std::make_shared<ImageSwappingGltfModifier>();
+  TilesetExternals externals{
+      pAssetAccessor,
+      pPrepareRendererResources,
+      asyncSystem,
+      pCreditSystem};
+  externals.pGltfModifier = pModifier;
+
+  CesiumGltf::Model initialModel;
+  initialModel.images.emplace_back().pAsset.emplace();
+  initialModel.images[0].pAsset->sizeBytes = 100;
+
+  auto pLoader = std::make_unique<SimpleTilesetContentLoader>();
+  pLoader->mockLoadTileContent = {
+      std::move(initialModel),
+      CesiumGeometry::Axis::Y,
+      std::nullopt,
+      std::nullopt,
+      std::nullopt,
+      nullptr,
+      nullptr,
+      {},
+      TileLoadResultState::Success};
+
+  auto pRootTile = std::make_unique<Tile>(pLoader.get());
+  pRootTile->setTileID("image-swap");
+
+  TilesetOptions options{};
+  IntrusivePointer<TilesetContentManager> pManager =
+      TilesetContentManager::createFromLoader(
+          externals,
+          options,
+          std::move(pLoader),
+          std::move(pRootTile));
+  pManager->waitUntilIdle(5000.0);
+
+  Tile& tile = *pManager->getRootTile();
+  pManager->loadTileContent(tile, options);
+  pManager->waitUntilIdle(5000.0);
+  pManager->updateTileContent(tile, options);
+  REQUIRE(tile.getState() == TileLoadState::Done);
+  REQUIRE(pManager->getTotalDataUsed() == 100);
+  const int32_t loadedTilesAfterInitialLoad =
+      pManager->getNumberOfTilesLoaded();
+
+  for (int64_t expectedImageBytes : {200, 300}) {
+    pModifier->trigger();
+    pManager->loadTileContent(tile, options);
+    pManager->waitUntilIdle(5000.0);
+    REQUIRE(tile.needsMainThreadLoading(pModifier.get()));
+
+    pManager->finishLoading(tile, options);
+    CHECK(tile.getState() == TileLoadState::Done);
+    CHECK(pManager->getTotalDataUsed() == expectedImageBytes);
+    CHECK(pManager->getNumberOfTilesLoaded() == loadedTilesAfterInitialLoad);
+  }
+
+  CHECK(pManager->unloadTileContent(tile));
+  CHECK(pManager->getTotalDataUsed() == 0);
+  CHECK(
+      pManager->getNumberOfTilesLoaded() == loadedTilesAfterInitialLoad - 1);
+}
