 #include <Cesium3DTilesSelection/Tileset.h>
 #include <CesiumGeospatial/Ellipsoid.h>
 #include <CesiumNativeTests/SimpleAssetAccessor.h>
@@ -7,7 +8,9 @@
 
 #include <doctest/doctest.h>
 
