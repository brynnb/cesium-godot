 #include <variant>
+#include <vector>
 
 using namespace Cesium3DTilesSelection;
 using namespace CesiumAsync;
@@ -35,6 +38,35 @@ uint32_t getMaxLevel(const std::vector<Tile::ConstPointer>& tiles) {
 
 } // namespace
 
+TEST_CASE("TileLoadTask priority ordering") {
+  // TilesetViewGroup sorts these tasks and consumes them from the back. Verify
+  // that urgency wins first, and that lower numeric priorities win within an
+  // urgency group. The tile pointer is deliberately not dereferenced by the
+  // comparator, so nullptr keeps this test focused on ordering semantics.
+  std::vector<TileLoadTask> tasks{
+      {nullptr, TileLoadPriorityGroup::Preload, 0.0},
+      {nullptr, TileLoadPriorityGroup::Normal, 10.0},
+      {nullptr, TileLoadPriorityGroup::Normal, 1.0},
+      {nullptr, TileLoadPriorityGroup::Urgent, 100.0},
+      {nullptr, TileLoadPriorityGroup::Urgent, 2.0}};
+
+  std::sort(tasks.begin(), tasks.end());
+
+  CHECK(tasks.back().group == TileLoadPriorityGroup::Urgent);
+  CHECK(tasks.back().priority == 2.0);
+  tasks.pop_back();
+  CHECK(tasks.back().group == TileLoadPriorityGroup::Urgent);
+  CHECK(tasks.back().priority == 100.0);
+  tasks.pop_back();
+  CHECK(tasks.back().group == TileLoadPriorityGroup::Normal);
+  CHECK(tasks.back().priority == 1.0);
+  tasks.pop_back();
+  CHECK(tasks.back().group == TileLoadPriorityGroup::Normal);
+  CHECK(tasks.back().priority == 10.0);
+  tasks.pop_back();
+  CHECK(tasks.back().group == TileLoadPriorityGroup::Preload);
+}
+
 TEST_CASE("TilesetViewGroup") {
   SUBCASE("used with Tileset") {
     TilesetExternals externals{
