@@ -334,8 +335,13 @@ CesiumAsync::Future<TileLoadResult>
 CesiumIonTilesetLoader::loadTileContent(const TileLoadInput& loadInput) {
   this->_pLogger = loadInput.pLogger;
 
+  // Per-load cancellation wrappers have different identities and lifetimes.
+  // Keep token refresh on the stable accessor and bind cancellation above it.
+  const auto& pStableAccessor = loadInput.contentOptions.pSharedAssetAccessor
+      ? loadInput.contentOptions.pSharedAssetAccessor
+      : loadInput.pAssetAccessor;
   if (this->_pTilesetAccessor == nullptr) {
-    this->_pTilesetAccessor = loadInput.pAssetAccessor;
+    this->_pTilesetAccessor = pStableAccessor;
     this->_pIonAccessor = std::make_shared<CesiumAsync::CesiumIonAssetAccessor>(
         this->_pLogger,
         this->_pTilesetAccessor,
@@ -357,7 +363,7 @@ CesiumIonTilesetLoader::loadTileContent(const TileLoadInput& loadInput) {
         });
   }
 
-  if (this->_pTilesetAccessor != loadInput.pAssetAccessor) {
+  if (this->_pTilesetAccessor != pStableAccessor) {
     // CesiumIonTilesetLoader requires this method to be called with the same
     // asset accessor instance every time.
     CESIUM_ASSERT(false);
@@ -369,7 +375,9 @@ CesiumIonTilesetLoader::loadTileContent(const TileLoadInput& loadInput) {
       loadInput.tile,
       loadInput.contentOptions,
       loadInput.asyncSystem,
-      this->_pIonAccessor,
+      std::make_shared<CancellationAssetAccessor>(
+          this->_pIonAccessor,
+          loadInput.contentOptions.requestOptions.pCancellationToken),
       this->_pLogger,
       loadInput.requestHeaders,
       loadInput.ellipsoid);
