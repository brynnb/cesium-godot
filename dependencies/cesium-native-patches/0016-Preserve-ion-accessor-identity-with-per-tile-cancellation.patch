index 000000000..99e8a52d4
--- /dev/null
+++ b/Cesium3DTilesSelection/src/CancellationAssetAccessor.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <CesiumAsync/IAssetAccessor.h>
+#include <CesiumAsync/AsyncSystem.h>
+#include <atomic>
+#include <utility>
+
+namespace Cesium3DTilesSelection {
+// Bind cancellation to one load, never to a cached ion authorization session.
+class CancellationAssetAccessor final : public CesiumAsync::IAssetAccessor {
+public:
+  CancellationAssetAccessor(
+      std::shared_ptr<CesiumAsync::IAssetAccessor> pDelegate,
+      std::shared_ptr<const std::atomic_bool> pCancellationToken)
+      : _pDelegate(std::move(pDelegate)),
+        _options{std::move(pCancellationToken)} {}
+
+  CesiumAsync::Future<std::shared_ptr<CesiumAsync::IAssetRequest>> get(
+      const CesiumAsync::AsyncSystem& asyncSystem,
+      const std::string& url,
+      const std::vector<THeader>& headers) override {
+    return this->_pDelegate->getWithOptions(
+        asyncSystem,
+        url,
+        headers,
+        this->_options);
+  }
+
+  CesiumAsync::Future<std::shared_ptr<CesiumAsync::IAssetRequest>> request(
+      const CesiumAsync::AsyncSystem& asyncSystem,
+      const std::string& verb,
+      const std::string& url,
+      const std::vector<THeader>& headers,
+      const std::span<const std::byte>& contentPayload) override {
+    return this->_pDelegate->requestWithOptions(
+        asyncSystem,
+        verb,
+        url,
+        headers,
+        contentPayload,
+        this->_options);
+  }
+
+  void tick() noexcept override { this->_pDelegate->tick(); }
+
+private:
+  std::shared_ptr<CesiumAsync::IAssetAccessor> _pDelegate;
+  CesiumAsync::AssetRequestOptions _options;
+};
+
+} // namespace Cesium3DTilesSelection
