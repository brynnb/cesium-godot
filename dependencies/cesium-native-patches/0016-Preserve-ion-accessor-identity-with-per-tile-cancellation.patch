 #include <Cesium3DTilesSelection/GltfModifier.h>
@@ -84,6 +86,63 @@ using namespace CesiumNativeTests;
 using namespace CesiumRasterOverlays;
 
 namespace {
+class IonCancellationProbe : public SimpleAssetAccessor {
+public:
+  IonCancellationProbe() : SimpleAssetAccessor({}) {}
+  std::vector<std::shared_ptr<const std::atomic_bool>> tokens;
+  CesiumAsync::Future<std::shared_ptr<CesiumAsync::IAssetRequest>>
+  getWithOptions(const CesiumAsync::AsyncSystem& asyncSystem,
+                 const std::string&, const std::vector<THeader>&,
+                 const CesiumAsync::AssetRequestOptions& options) override {
+    tokens.push_back(options.pCancellationToken);
+    return asyncSystem.createResolvedFuture(
+        std::shared_ptr<CesiumAsync::IAssetRequest>());
+  }
+};
+
+class IonRequestProbeLoader : public TilesetContentLoader {
+public:
+  CesiumAsync::Future<TileLoadResult>
+  loadTileContent(const TileLoadInput& input) override {
+    return input.pAssetAccessor->get(input.asyncSystem, "https://example.invalid/tile", {})
+        .thenImmediately([](std::shared_ptr<CesiumAsync::IAssetRequest>&&) {
+          TileLoadResult result;
+          result.state = TileLoadResultState::Success;
+          return result;
+        });
+  }
+  TileChildrenResult createTileChildren(const Tile&, const Ellipsoid&) override {
+    return {};
+  }
+};
+
+TEST_CASE("Ion tile loads retain stable identity and independent cancellation") {
+  CesiumAsync::AsyncSystem asyncSystem(std::make_shared<SimpleTaskProcessor>());
+  auto accessor = std::make_shared<IonCancellationProbe>();
+  CesiumIonTilesetLoader loader(
+      "https://example.invalid/endpoint", "test-token",
+      std::make_unique<IonRequestProbeLoader>(), {});
+  Tile tile(&loader);
+  auto first = std::make_shared<std::atomic_bool>(false);
+  auto second = std::make_shared<std::atomic_bool>(false);
+  for (const auto& token : {first, second}) {
+    TilesetContentOptions options;
+    options.pSharedAssetAccessor = accessor;
+    options.requestOptions.pCancellationToken = token;
+    TileLoadInput input{
+        tile, options, asyncSystem,
+        std::make_shared<CancellationAssetAccessor>(accessor, token),
+        spdlog::default_logger(), {}, Ellipsoid::WGS84};
+    CHECK(loader.loadTileContent(input).wait().state == TileLoadResultState::Success);
+    first->store(true);
+  }
+  REQUIRE(accessor->tokens.size() == 2);
+  CHECK(accessor->tokens[0] == first);
+  CHECK(accessor->tokens[1] == second);
+  CHECK(accessor->tokens[0]->load());
+  CHECK_FALSE(accessor->tokens[1]->load());
+}
+
