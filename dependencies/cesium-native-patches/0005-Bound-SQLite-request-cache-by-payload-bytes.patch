+  // Clearing a cache is expected to release disk space, not merely leave
+  // deleted SQLite pages in a potentially very large database and WAL. Reset
+  // every reusable statement before VACUUM so no statement retains a read
+  // transaction, then compact and truncate the WAL while holding the cache
+  // mutex.
+  SqliteStatementPtr* statements[] = {
+      &this->_pImpl->_getEntryStmtWrapper,
+      &this->_pImpl->_updateLastAccessedTimeStmtWrapper,
+      &this->_pImpl->_storeResponseStmtWrapper,
+      &this->_pImpl->_totalItemsQueryStmtWrapper,
+      &this->_pImpl->_lruDataSizesQueryStmtWrapper,
+      &this->_pImpl->_deleteExpiredStmtWrapper,
+      &this->_pImpl->_deleteLRUStmtWrapper,
+      &this->_pImpl->_clearAllStmtWrapper};
+  for (SqliteStatementPtr* pStatement : statements) {
+    status = CESIUM_SQLITE(sqlite3_reset)(pStatement->get());
+    if (status != SQLITE_OK) {
+      SPDLOG_LOGGER_ERROR(
+          this->_pImpl->_pLogger, CESIUM_SQLITE(sqlite3_errstr)(status));
+      return false;
+    }
+  }
+
+  char* errorMessage = nullptr;
+  status = CESIUM_SQLITE(sqlite3_exec)(
+      this->_pImpl->_pConnection.get(),
+      VACUUM_SQL.c_str(),
+      nullptr,
+      nullptr,
+      &errorMessage);
+  if (status != SQLITE_OK) {
+    SPDLOG_LOGGER_ERROR(
+        this->_pImpl->_pLogger,
+        errorMessage != nullptr ? errorMessage
+                                : CESIUM_SQLITE(sqlite3_errstr)(status));
+    CESIUM_SQLITE(sqlite3_free)(errorMessage);
+    return false;
+  }
+
+  errorMessage = nullptr;
+  status = CESIUM_SQLITE(sqlite3_exec)(
+      this->_pImpl->_pConnection.get(),
+      CHECKPOINT_SQL.c_str(),
+      nullptr,
+      nullptr,
+      &errorMessage);
+  if (status != SQLITE_OK) {
+    SPDLOG_LOGGER_ERROR(
+        this->_pImpl->_pLogger,
+        errorMessage != nullptr ? errorMessage
+                                : CESIUM_SQLITE(sqlite3_errstr)(status));
+    CESIUM_SQLITE(sqlite3_free)(errorMessage);
+    return false;
+  }
+
   return true;
 }
 
