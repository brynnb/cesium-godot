+
+TEST_CASE("Sqlite cache prunes by logical response bytes") {
+  OwnedTempFile cacheFile;
+  SqliteCache diskCache(
+      spdlog::default_logger(), cacheFile.getPath().string(), 100, 9);
+  REQUIRE(diskCache.clearAll());
+
+  const HttpHeaders headers{{"Content-Type", "application/octet-stream"}};
+  const std::vector<std::byte> fiveBytes{
+      std::byte(0),
+      std::byte(1),
+      std::byte(2),
+      std::byte(3),
+      std::byte(4)};
+  const std::time_t expiry = std::time(nullptr) + 3600;
+  for (size_t i = 0; i < 3; ++i) {
+    REQUIRE(diskCache.storeEntry(
+        "ByteKey" + std::to_string(i),
+        expiry,
+        "https://example.com/" + std::to_string(i),
+        "GET",
+        HttpHeaders{},
+        200,
+        headers,
+        fiveBytes));
+  }
+
+  REQUIRE(diskCache.prune());
+  CHECK(diskCache.getEntry("ByteKey0") == std::nullopt);
+  CHECK(diskCache.getEntry("ByteKey1") == std::nullopt);
+  CHECK(diskCache.getEntry("ByteKey2") != std::nullopt);
+  REQUIRE(diskCache.clearAll());
+}
