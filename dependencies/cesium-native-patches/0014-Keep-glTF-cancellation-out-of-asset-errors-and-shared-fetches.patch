+void throwIfCanceled(const GltfReaderOptions& options) {
+  if (options.requestOptions.isCancellationRequested()) {
+    // This is control flow, not malformed content. TilesetContentManager owns
+    // the token and returns the tile to Unloaded without an error callback.
+    throw std::runtime_error("glTF load canceled");
+  }
+}
