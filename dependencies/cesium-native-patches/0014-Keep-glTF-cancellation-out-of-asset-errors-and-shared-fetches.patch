@@ -56,6 +56,33 @@ using namespace CesiumGltf;
 using namespace CesiumNativeTests;
 using namespace CesiumUtility;
 
+TEST_CASE("TileLoadInput owns its per-load request context") {
+  Tile tile(nullptr);
+  AsyncSystem asyncSystem(std::make_shared<SimpleTaskProcessor>());
+  auto logger = spdlog::default_logger();
+  std::vector<IAssetAccessor::THeader> headers;
+  auto token = std::make_shared<std::atomic_bool>(false);
+  std::weak_ptr<IAssetAccessor> weakAccessor;
+  auto input = [&]() {
+    std::shared_ptr<IAssetAccessor> accessor =
+        std::make_shared<SimpleAssetAccessor>(
+            std::map<std::string, std::shared_ptr<SimpleAssetRequest>>{});
+    weakAccessor = accessor;
+    TilesetContentOptions options;
+    options.requestOptions.pCancellationToken = token;
+    options.pSharedAssetAccessor = accessor;
+    return TileLoadInput(tile, options, asyncSystem, accessor, logger, headers);
+  }();
+  CHECK_FALSE(weakAccessor.expired());
+  CHECK(input.pAssetAccessor == weakAccessor.lock());
+  auto copy = input;
+  auto gltfOptions = copy.contentOptions.toGltfReaderOptions();
+  CHECK(gltfOptions.pSharedAssetAccessor == input.pAssetAccessor);
+  CHECK_FALSE(gltfOptions.requestOptions.isCancellationRequested());
+  token->store(true);
+  CHECK(gltfOptions.requestOptions.isCancellationRequested());
+}
+
