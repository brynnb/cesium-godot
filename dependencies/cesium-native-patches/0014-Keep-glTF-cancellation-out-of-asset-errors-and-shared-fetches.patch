diff --git a/CesiumGltfReader/test/TestGltfCancellation.cpp b/CesiumGltfReader/test/TestGltfCancellation.cpp
new file mode 100644
index 0000000..7b17028
--- /dev/null
+++ b/CesiumGltfReader/test/TestGltfCancellation.cpp
@@ -0,0 +1,169 @@
+#include <CesiumAsync/AsyncSystem.h>
+#include <CesiumAsync/Promise.h>
+#include <CesiumGltfReader/GltfReader.h>
+#include <CesiumNativeTests/SimpleAssetAccessor.h>
+#include <CesiumNativeTests/SimpleAssetRequest.h>
+#include <CesiumNativeTests/SimpleAssetResponse.h>
+#include <CesiumNativeTests/SimpleTaskProcessor.h>
+#include <CesiumNativeTests/readFile.h>
+#include <CesiumNativeTests/waitForFuture.h>
+
+#include <doctest/doctest.h>
+
+#include <atomic>
+#include <filesystem>
+#include <functional>
+#include <optional>
+#include <stdexcept>
+#include <string>
+
+using namespace CesiumAsync;
+using namespace CesiumGltfReader;
+using namespace CesiumNativeTests;
+
+namespace {
+CesiumUtility::IntrusivePointer<GltfSharedAssetSystem> imageDepot() {
+  CesiumUtility::IntrusivePointer<GltfSharedAssetSystem> result =
+      new GltfSharedAssetSystem();
+  result->pImage.emplace(std::function(
+      [](const SharedAssetContext& context,
+         const NetworkImageAssetDescriptor& key) {
+        return key.load(context.asyncSystem, context.pAssetAccessor);
+      }));
+  return result;
+}
+
+class PendingImageAccessor : public SimpleAssetAccessor {
+public:
+  PendingImageAccessor() : SimpleAssetAccessor({}) {}
+
+  Future<std::shared_ptr<IAssetRequest>> get(
+      const AsyncSystem& asyncSystem,
+      const std::string& url,
+      const std::vector<THeader>&) override {
+    ++requests;
+    requestedUrl = url;
+    pending = asyncSystem.createPromise<std::shared_ptr<IAssetRequest>>();
+    return pending->getFuture();
+  }
+
+  void resolve(bool valid = true) {
+    REQUIRE(pending);
+    auto bytes = valid
+                     ? readFile(
+                           std::filesystem::path(CesiumGltfReader_TEST_DATA_DIR) /
+                           "DracoCompressed/CesiumMilkTruck.png")
+                     : std::vector<std::byte>{std::byte{0x01}};
+    pending->resolve(std::make_shared<SimpleAssetRequest>(
+        "GET",
+        requestedUrl,
+        HttpHeaders{},
+        std::make_unique<SimpleAssetResponse>(
+            200, "image/png", HttpHeaders{}, bytes)));
+    pending.reset();
+  }
+
+  int requests = 0;
+  std::string requestedUrl;
+  std::optional<Promise<std::shared_ptr<IAssetRequest>>> pending;
+};
+
+Future<GltfReaderResult> readImage(
+    const AsyncSystem& asyncSystem,
+    const std::shared_ptr<IAssetAccessor>& accessor,
+    const GltfReaderOptions& options) {
+  static const std::string json =
+      R"({"asset":{"version":"2.0"},"images":[{"uri":"texture.png","mimeType":"image/png"}]})";
+  return GltfReader().readGltfAndExternalData(
+      std::as_bytes(std::span(json.data(), json.size())),
+      asyncSystem,
+      HttpHeaders{},
+      accessor,
+      "https://cancellation.test/tile.gltf",
+      options);
+}
+} // namespace
+
+TEST_CASE("glTF cancellation is not image corruption") {
+  AsyncSystem asyncSystem(std::make_shared<SimpleTaskProcessor>());
+  auto accessor = std::make_shared<PendingImageAccessor>();
+  auto token = std::make_shared<std::atomic_bool>(false);
+  GltfReaderOptions options;
+  // Exercise the depot's exception-to-ErrorList conversion that previously
+  // caused canceled requests to be decoded as corrupt images.
+  options.pSharedAssetSystem = imageDepot();
+  options.requestOptions.pCancellationToken = token;
+
+  auto canceled = readImage(asyncSystem, accessor, options);
+  REQUIRE(accessor->pending);
+  token->store(true);
+  accessor->pending->reject(
+      std::runtime_error("GET request canceled before decompression"));
+  CHECK_THROWS_WITH(
+      waitForFuture(asyncSystem, std::move(canceled)), "glTF load canceled");
+
+  // A fresh attempt must still load the same image successfully.
+  options.requestOptions.pCancellationToken =
+      std::make_shared<std::atomic_bool>(false);
+  auto retry = readImage(asyncSystem, accessor, options);
+  accessor->resolve();
+  auto result = waitForFuture(asyncSystem, std::move(retry));
+  REQUIRE(result.model);
+  CHECK(result.errors.empty());
+  CHECK(result.warnings.empty());
+  REQUIRE(result.model->images.size() == 1);
+  CHECK(result.model->images[0].pAsset != nullptr);
+}
+
+TEST_CASE("glTF cancellation does not poison shared image consumers") {
+  AsyncSystem asyncSystem(std::make_shared<SimpleTaskProcessor>());
+  auto privateAccessor = std::make_shared<PendingImageAccessor>();
+  auto sharedAccessor = std::make_shared<PendingImageAccessor>();
+  auto token = std::make_shared<std::atomic_bool>(false);
+  GltfReaderOptions options;
+  options.requestOptions.pCancellationToken = token;
+  options.pSharedAssetAccessor = sharedAccessor;
+  options.pSharedAssetSystem = imageDepot();
+
+  auto canceled = readImage(asyncSystem, privateAccessor, options);
+  GltfReaderOptions otherOptions = options;
+  otherOptions.requestOptions.pCancellationToken =
+      std::make_shared<std::atomic_bool>(false);
+  auto live = readImage(asyncSystem, privateAccessor, otherOptions);
+  CHECK(privateAccessor->requests == 0);
+  CHECK(sharedAccessor->requests == 1);
+
+  token->store(true);
+  sharedAccessor->resolve();
+  CHECK_THROWS_WITH(
+      waitForFuture(asyncSystem, std::move(canceled)), "glTF load canceled");
+  auto result = waitForFuture(asyncSystem, std::move(live));
+  REQUIRE(result.model);
+  CHECK(result.errors.empty());
+  CHECK(result.warnings.empty());
+  CHECK(result.model->images[0].pAsset != nullptr);
+}
+
+TEST_CASE("uncanceled corrupt glTF images still report errors") {
+  AsyncSystem asyncSystem(std::make_shared<SimpleTaskProcessor>());
+  auto accessor = std::make_shared<PendingImageAccessor>();
+  GltfReaderOptions options;
+  options.pSharedAssetSystem = nullptr;
+  auto future = readImage(asyncSystem, accessor, options);
+  accessor->resolve(false);
+  auto result = waitForFuture(asyncSystem, std::move(future));
+  CHECK_FALSE(result.errors.empty());
+  CHECK_FALSE(result.warnings.empty());
+}
+
+TEST_CASE("canceled glTF postprocessing never decodes missing image data") {
+  GltfReaderOptions options;
+  options.requestOptions.pCancellationToken =
+      std::make_shared<std::atomic_bool>(true);
+  GltfReaderResult result;
+  result.model.emplace();
+  result.model->images.emplace_back().mimeType = "image/png";
+  CHECK_THROWS_WITH(
+      GltfReader().postprocessGltf(result, options), "glTF load canceled");
+  CHECK(result.errors.empty());
+}
