+void TilesetContentManager::cancelUnneededTileLoads(
+    const TilesetOptions& options) {
+  if (!options.enableStaleRequestCancellation) {
+    return;
+  }
+
+  for (const auto& [pTile, pCancellationToken] :
+       this->_tileLoadCancellationTokens) {
+    if (
+        pTile == nullptr || !pCancellationToken ||
+        pCancellationToken->load(std::memory_order_relaxed)
+    ) {
+      continue;
+    }
+
+    const bool stillNeeded = std::any_of(
+        this->_requesters.begin(),
+        this->_requesters.end(),
+        [pTile](const TileLoadRequester* pRequester) {
+          return pRequester != nullptr &&
+                 pRequester->isTileLoadStillNeeded(*pTile);
+        });
+    if (!stillNeeded) {
+      pCancellationToken->store(true, std::memory_order_relaxed);
+      ++this->_canceledTileLoads;
+    }
+  }
+}
