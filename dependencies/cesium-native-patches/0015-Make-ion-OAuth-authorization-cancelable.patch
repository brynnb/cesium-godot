diff --git a/CesiumClientCommon/test/TestOAuth2PKCE.cpp b/CesiumClientCommon/test/TestOAuth2PKCE.cpp
new file mode 100644
index 000000000..077cea872
--- /dev/null
+++ b/CesiumClientCommon/test/TestOAuth2PKCE.cpp
@@ -0,0 +1,50 @@
+#include <CesiumAsync/AsyncSystem.h>
+#include <CesiumClientCommon/OAuth2PKCE.h>
+#include <CesiumNativeTests/SimpleTaskProcessor.h>
+
+#include <doctest/doctest.h>
+#include <httplib.h>
+
+#include <memory>
+#include <string>
+#include <vector>
+
+using namespace CesiumAsync;
+using namespace CesiumClientCommon;
+using namespace CesiumNativeTests;
+
+TEST_CASE("OAuth2PKCE authorization can be canceled") {
+  AsyncSystem asyncSystem(std::make_shared<SimpleTaskProcessor>());
+  std::string openedUrl;
+
+  OAuth2Authorization authorization = OAuth2PKCE::authorizeCancelable(
+      asyncSystem,
+      nullptr,
+      "Cesium Native Test",
+      OAuth2ClientOptions{"1234", "/oauth/callback", std::nullopt, true},
+      std::vector<std::string>{"profile:read"},
+      [&openedUrl](const std::string& url) { openedUrl = url; },
+      "https://example.com/oauth/token",
+      "https://example.com/oauth");
+
+  CHECK(openedUrl.find("code_challenge=") != std::string::npos);
+  CHECK(openedUrl.find("state=") != std::string::npos);
+  CHECK(openedUrl.find("http%3A%2F%2F127.0.0.1%3A") != std::string::npos);
+
+  const std::string portPrefix = "http%3A%2F%2F127.0.0.1%3A";
+  const size_t portStart = openedUrl.find(portPrefix) + portPrefix.size();
+  const size_t portEnd = openedUrl.find("%2F", portStart);
+  REQUIRE(portEnd != std::string::npos);
+  const int port = std::stoi(openedUrl.substr(portStart, portEnd - portStart));
+
+  authorization.cancel();
+  authorization.cancel();
+  auto result = std::move(authorization.future).wait();
+  CHECK_FALSE(result.value.has_value());
+  REQUIRE(result.errors.errors.size() == 1);
+  CHECK(result.errors.errors[0].find("canceled") != std::string::npos);
+
+  httplib::Server replacementServer;
+  CHECK(replacementServer.bind_to_port("127.0.0.1", port));
+  replacementServer.stop();
+}
