+/**
+ * @brief An in-progress OAuth2 authorization operation.
+ *
+ * The future resolves with the authorization result. Calling `cancel` closes
+ * the temporary loopback listener and resolves the future with a cancellation
+ * error. Cancellation is idempotent and safe to invoke after completion.
+ */
+struct OAuth2Authorization {
+  CesiumAsync::Future<CesiumUtility::Result<OAuth2TokenResponse>> future;
+  std::function<void()> cancel;
+};
