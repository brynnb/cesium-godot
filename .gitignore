
# Common stuff
.vs
.hx
*.sln
*.obj
*.dll
*.lib
*.os
*.so
*.tcl
.vscode
*.pdb
**/__pycache__/
.cache/*

compile_commands.json

# All provisioned sources, vcpkg data, and out-of-source build products live
# here so disk use is visible and removable with one directory.
build/

# Ignore the Cesium native directory
cesium_godot/native

# Ignore the actual godotcpp module (directory or local worktree symlink)
godot-cpp



# The top-level addon directory is the distributable package. Native libraries
# and Godot-generated metadata are local build products.
addons/cesium_godot/lib/*
addons/cesium_godot/**/*.uid
addons/cesium_godot/**/*.import

!godot-html/ultralight/lib/*.lib
!cesium_godot/third_party/litehtml/*.lib

# Headless test imports are generated beside the visible test fixture and are
# removed by tests/run_godot_tests.sh after each run.
tests/godot/.godot/
tests/godot/.test-user-data/
tests/godot/**/*.uid
tests/godot/**/*.import
tests/csharp/.godot/
tests/csharp/.test-user-data/
tests/csharp/**/*.uid
tests/csharp/**/*.import
tests/csharp-2dog/.godot/
tests/csharp-2dog/.test-user-data/
tests/csharp-2dog/**/*.uid
tests/csharp-2dog/**/*.import
tests/csharp-2dog/**/bin/
tests/csharp-2dog/**/obj/
tests/godot-editor/.godot/
tests/godot-editor/.test-user-data/
tests/godot-editor/**/*.uid
tests/godot-editor/**/*.import

# Example projects generate the same ordinary Godot import/user-data folders.
examples/**/.godot/
!examples/lifecycle_material_demo/.godot/
examples/lifecycle_material_demo/.godot/*
!examples/lifecycle_material_demo/.godot/extension_list.cfg
examples/**/.test-user-data/
examples/**/*.uid
examples/**/*.import

# Ignore large files
*.ipch
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.dblite
